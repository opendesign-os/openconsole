{
  "name": "@openconsole/agent",
  "version": "0.0.1",
  "private": true,
  "description": "基于 graph 的 harness agent 框架：运行即只追加的 DAG，内环借鉴 LLMCompiler，外环借鉴 GPTSwarm、AFlow、ADAS",
  "license": "MIT",
  "keywords": [
    "agent",
    "harness",
    "llm",
    "openai",
    "tool-calling",
    "dag",
    "llmcompiler",
    "gptswarm",
    "aflow",
    "adas",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmic-gao/openconsole.git",
    "directory": "packages/agent"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "check": "tsc && vitest run"
  },
  "dependencies": {
    "@openconsole/graph": "workspace:*",
    "@openconsole/signal": "workspace:*",
    "ajv": "^8.20.0",
    "eventsource-parser": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3"
  }
}
