{
  "name": "@openconsole/graph",
  "version": "0.0.1",
  "private": true,
  "description": "类型化端口、Structure 契约、不可变 CSR 与可中断算法的有向图内核",
  "license": "MIT",
  "keywords": [
    "graph",
    "digraph",
    "directed-graph",
    "dag",
    "toposort",
    "dijkstra",
    "scc",
    "csr",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmic-gao/openconsole.git",
    "directory": "packages/graph"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./algorithm": "./core/algorithm/index.ts",
    "./serialize": "./core/serialize/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "bench": "vitest bench --run --reporter=verbose",
    "typecheck": "tsc",
    "check": "tsc && vitest run"
  },
  "dependencies": {
    "@openconsole/queue": "workspace:*",
    "@openconsole/signal": "workspace:*"
  }
}
