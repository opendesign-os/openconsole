{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@openconsole/tsconfig/node",
  "compilerOptions": {
    "module": "nodenext",
    // 不继承 strict：SDK 的 Transport 把 onclose / sessionId 声明成 `prop?: T` 却返回
    // `T | undefined`，与 exactOptionalPropertyTypes 冲突，故只单独开启下标检查。
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "tests"]
}
