{
  "name": "@openconsole/mcp",
  "version": "0.0.1",
  "private": true,
  "description": "最小 MCP Gateway：聚合多个上游 MCP Server，提供命名空间、路由、对账与中间件治理",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "proxy",
    "aggregator",
    "llm",
    "agent",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmic-gao/openconsole.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "openmcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc && vitest run",
    "dev": "tsx src/bin.ts openmcp.yaml"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "zod": "^4.4.3"
  }
}
